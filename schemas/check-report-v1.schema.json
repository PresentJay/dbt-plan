{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dbt-plan check report v1",
  "description": "Structural contract, not a safety verdict. Unknown safety and risk strings require review. All objects accept additive fields.",
  "type": "object",
  "required": ["summary", "models", "parse_failures", "stale_sources", "skipped_models", "uncompiled_models"],
  "additionalProperties": true,
  "dependentRequired": {"causal_graph": ["findings"]},
  "properties": {
    "summary": {"$ref": "#/$defs/summary"},
    "models": {"type": "array", "items": {"$ref": "#/$defs/model"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "causal_graph": {"$ref": "#/$defs/causalGraph"},
    "ignored_models": {"$ref": "#/$defs/strings"},
    "unmatched_ignore_models": {"$ref": "#/$defs/strings"},
    "parse_failures": {"$ref": "#/$defs/strings"},
    "stale_sources": {"$ref": "#/$defs/strings"},
    "skipped_models": {"$ref": "#/$defs/strings"},
    "uncompiled_models": {"$ref": "#/$defs/strings"},
    "baseline_problem": {"type": "string"},
    "analysis": {"$ref": "#/$defs/analysis"}
  },
  "$defs": {
    "graphResource": {
      "allOf": [{"$ref": "#/$defs/resource"}, {"type": "object"}]
    },
    "causalGraph": {
      "type": "object",
      "required": ["nodes", "edges", "associations", "losses", "read_summaries", "has_cycles", "external_coverage"],
      "additionalProperties": true,
      "properties": {
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/causalNode"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/causalEdge"}},
        "associations": {"type": "array", "items": {"$ref": "#/$defs/causalAssociation"}},
        "losses": {"type": "array", "items": {"$ref": "#/$defs/causalLoss"}},
        "read_summaries": {"type": "array", "items": {
          "type": "object", "required": ["root", "resolved_empty_non_edges"], "additionalProperties": true,
          "properties": {"root": {"$ref": "#/$defs/graphResource"}, "resolved_empty_non_edges": {"$ref": "#/$defs/count"}}
        }},
        "has_cycles": {"type": "boolean"},
        "external_coverage": {"type": "string", "description": "Currently unknown, including reports with no impacts. Unknown future values require review."}
      }
    },
    "causalNode": {
      "type": "object", "additionalProperties": true,
      "required": ["resource", "materialization", "on_schema_change", "columns_removed", "loss_evidence"],
      "properties": {
        "resource": {"$ref": "#/$defs/graphResource"},
        "materialization": {"$ref": "#/$defs/nullableString"},
        "on_schema_change": {"$ref": "#/$defs/nullableString"},
        "columns_removed": {"$ref": "#/$defs/strings"},
        "loss_evidence": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/evidence"}]}
      }
    },
    "causalEdge": {
      "type": "object", "additionalProperties": true,
      "required": ["source", "target", "kind", "evidence", "columns_removed", "root", "revisions"],
      "properties": {
        "source": {"$ref": "#/$defs/graphResource"}, "target": {"$ref": "#/$defs/graphResource"},
        "kind": {"type": "string", "description": "Unknown kinds require review; dependency and read_check never prove column flow."},
        "evidence": {"$ref": "#/$defs/evidence"}, "columns_removed": {"$ref": "#/$defs/strings"},
        "root": {"$ref": "#/$defs/resource"}, "revisions": {"$ref": "#/$defs/strings"}
      }
    },
    "causalAssociation": {
      "type": "object", "additionalProperties": true,
      "required": ["finding_index", "source", "affected", "columns_added", "columns_removed", "evidence", "cause_finding_indices"],
      "properties": {
        "finding_index": {"$ref": "#/$defs/count"},
        "source": {"$ref": "#/$defs/resource"}, "affected": {"$ref": "#/$defs/resource"},
        "columns_added": {"$ref": "#/$defs/strings"}, "columns_removed": {"$ref": "#/$defs/strings"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "cause_finding_indices": {"type": "array", "items": {"$ref": "#/$defs/count"}}
      }
    },
    "causalLoss": {
      "type": "object", "additionalProperties": true,
      "required": ["root", "resource", "columns_removed", "evidence"],
      "properties": {
        "root": {"$ref": "#/$defs/graphResource"}, "resource": {"$ref": "#/$defs/graphResource"},
        "columns_removed": {"$ref": "#/$defs/strings"}, "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "resource": {
      "type": ["object", "null"],
      "required": ["name", "unique_id", "candidates"],
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string"},
        "unique_id": {"$ref": "#/$defs/nullableString"},
        "candidates": {"$ref": "#/$defs/strings"},
        "original_file_path": {"$ref": "#/$defs/nullableString"}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["origin", "state", "reason_code", "columns"],
      "additionalProperties": true,
      "properties": {
        "origin": {"type": "string"},
        "state": {"type": "string", "description": "Known states: exact, conservative, unknown. Unfamiliar states require review."},
        "reason_code": {"type": "string"},
        "columns": {"$ref": "#/$defs/strings"},
        "compiled_path": {"$ref": "#/$defs/nullableString"}
      }
    },
    "finding": {
      "type": "object",
      "required": ["contract_version", "rule_code", "source", "affected", "column", "columns", "columns_added", "columns_removed", "severity", "raw_risk", "message", "evidence", "uncertainty", "waiver_allowed"],
      "additionalProperties": true,
      "properties": {
        "contract_version": {"type": "integer", "minimum": 1, "description": "Only version 1 is currently understood. Unknown versions require review."},
        "rule_code": {"type": "string"},
        "source": {"$ref": "#/$defs/resource"},
        "affected": {"$ref": "#/$defs/resource"},
        "column": {"$ref": "#/$defs/nullableString"},
        "columns": {"$ref": "#/$defs/strings"},
        "columns_added": {"$ref": "#/$defs/strings"},
        "columns_removed": {"$ref": "#/$defs/strings"},
        "severity": {"type": "string"},
        "raw_risk": {"type": "string"},
        "message": {"type": "string"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "uncertainty": {"$ref": "#/$defs/strings"},
        "waiver_allowed": {"type": "boolean"}
      }
    },
    "strings": {"type": "array", "items": {"type": "string"}},
    "nullableString": {"type": ["string", "null"]},
    "count": {"type": "integer", "minimum": 0},
    "summary": {
      "type": "object",
      "required": ["total", "safe", "warning", "destructive"],
      "additionalProperties": true,
      "properties": {
        "total": {"$ref": "#/$defs/count"},
        "safe": {"$ref": "#/$defs/count"},
        "warning": {"$ref": "#/$defs/count"},
        "destructive": {"$ref": "#/$defs/count"},
        "acknowledged": {"$ref": "#/$defs/count"},
        "cascade_risks": {"$ref": "#/$defs/count"}
      }
    },
    "model": {
      "type": "object",
      "required": ["model_name", "materialization", "on_schema_change", "safety", "operations", "columns_added", "columns_removed", "acknowledged"],
      "additionalProperties": true,
      "properties": {
        "model_name": {"type": "string"},
        "materialization": {"type": "string"},
        "on_schema_change": {"$ref": "#/$defs/nullableString"},
        "safety": {
          "type": "string",
          "description": "Known values: safe, warning, destructive. Unknown strings require review; never interpret them as safe."
        },
        "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
        "columns_added": {"$ref": "#/$defs/strings"},
        "columns_removed": {"$ref": "#/$defs/strings"},
        "acknowledged": {"type": "boolean"},
        "downstream": {"$ref": "#/$defs/strings"},
        "downstream_impacts": {"type": "array", "items": {"$ref": "#/$defs/impact"}},
        "downstream_exposures": {"type": "array", "items": {"$ref": "#/$defs/exposure"}}
      }
    },
    "operation": {
      "type": "object",
      "required": ["operation", "column"],
      "additionalProperties": true,
      "properties": {
        "operation": {"type": "string"},
        "column": {"$ref": "#/$defs/nullableString"}
      }
    },
    "impact": {
      "type": "object",
      "required": ["model_name", "risk", "reason"],
      "additionalProperties": true,
      "properties": {
        "model_name": {"type": "string"},
        "risk": {"type": "string", "description": "Open vocabulary. Unknown risks require review."},
        "reason": {"type": "string"}
      }
    },
    "exposure": {
      "type": "object",
      "required": ["name", "type", "owner", "url"],
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string"},
        "owner": {"type": "string"},
        "url": {"type": "string"}
      }
    },
    "analysis": {
      "type": "object",
      "description": "Optional provenance metadata; individual fields are optional for legacy and additive report compatibility.",
      "additionalProperties": true,
      "properties": {
        "dialect": {"type": "string"},
        "adapter_type": {"$ref": "#/$defs/nullableString"},
        "dialect_source": {"type": "string"},
        "baseline": {"$ref": "#/$defs/baseline"},
        "selection": {"$ref": "#/$defs/nullableString"},
        "unsupported_languages": {"$ref": "#/$defs/strings"}
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "revision": {"$ref": "#/$defs/nullableString"},
        "created_at": {"$ref": "#/$defs/nullableString"},
        "dbt_plan_version": {"type": "string"}
      }
    }
  }
}
